# Recopier en .env puis adapter
RAG_QDRANT_URL=http://qdrant:6333
RAG_EMBEDDING_BACKEND=sentence-transformers
RAG_RERANKER_BACKEND=cross-encoder
# Génération : "none" (réponse extractive), "gemini" ou "openai" (toute API compatible : OpenAI, Mistral, Ollama)
RAG_LLM_PROVIDER=none
RAG_LLM_MODEL=gemini-2.5-flash-lite
RAG_LLM_API_KEY=
RAG_PROMPT_AB=v1:50,v2:50
# Clés d'API par client : "cle:tenant,cle2:tenant2" (vide : API ouverte)
RAG_API_KEYS=
